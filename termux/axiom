#!/usr/bin/env python3
"""AXIOM: local brain switchboard for Termux. Stdlib only."""
import base64, configparser, json, os, re, signal, subprocess, sys, threading, time, urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

AX = os.path.expanduser("~/axiom")
CONF = configparser.ConfigParser()
CONF.read(os.path.join(AX, "axiom.conf"))
BRAINS = dict(CONF["brains"]) if CONF.has_section("brains") else {}
PORT = CONF.getint("server", "port", fallback=8080)
THREADS = CONF.get("server", "threads", fallback="4")
CTX = CONF.get("server", "context", fallback="4096")
PIDF, STATEF = os.path.join(AX, "server.pid"), os.path.join(AX, "brain")
URL = f"http://127.0.0.1:{PORT}"

# Fast deterministic router: no extra model needed, costs 0 ms.
ROUTES = [
    ("code",  r"\b(code|python|bash|script|function|bug|error|compile|regex|sql|javascript|kotlin|html|css)\b"),
    ("think", r"\b(why|prove|plan|strategy|compare|decide|calculate|solve|math|step by step|reason|pros and cons)\b"),
]

def route(prompt):
    for brain, pat in ROUTES:
        if re.search(pat, prompt, re.I) and brain in BRAINS:
            return brain
    return "chat"

def current():
    try:
        pid = int(open(PIDF).read())
        os.kill(pid, 0)
        return open(STATEF).read().strip()
    except Exception:
        return None

def healthy():
    try:
        return urllib.request.urlopen(URL + "/health", timeout=2).status == 200
    except Exception:
        return False

def stop():
    try:
        os.kill(int(open(PIDF).read()), signal.SIGTERM)
        time.sleep(1)
    except Exception:
        pass
    for f in (PIDF, STATEF):
        if os.path.exists(f):
            os.remove(f)

def start(brain):
    if brain not in BRAINS:
        sys.exit(f"unknown brain '{brain}'. options: {', '.join(BRAINS)}")
    if current() == brain and healthy():
        return
    stop()
    print(f"[axiom] loading {brain} brain ({BRAINS[brain]}) ...", file=sys.stderr)
    log = open(os.path.join(AX, "logs", f"{brain}.log"), "a")
    p = subprocess.Popen(
        ["llama-server", "-hf", BRAINS[brain], "--port", str(PORT), "-t", THREADS,
         "-c", CTX, "--jinja", "--host", "127.0.0.1"],
        stdout=log, stderr=log, start_new_session=True)
    open(PIDF, "w").write(str(p.pid))
    open(STATEF, "w").write(brain)
    for _ in range(1800):  # first run may be downloading GBs
        if healthy():
            print(f"[axiom] {brain} online at {URL}", file=sys.stderr)
            return
        if p.poll() is not None:
            sys.exit(f"[axiom] server exited; see {AX}/logs/{brain}.log")
        time.sleep(1)
    sys.exit("[axiom] timed out waiting for server")

def memory():
    d = os.path.join(AX, "memory")
    parts = [open(os.path.join(d, f)).read() for f in sorted(os.listdir(d)) if f.endswith(".md")] if os.path.isdir(d) else []
    return "\n\n".join(parts)

REMEMBER = re.compile(r"^\s*remember( that)?[:,]?\s+(.+)", re.I | re.S)

def remember(fact):
    with open(os.path.join(AX, "memory", "notes.md"), "a") as f:
        f.write(f"- {fact.strip()}  ({time.strftime('%Y-%m-%d')})\n")
    return "Stored in memory core."

def stream(content, brain):
    """Yield reply text chunks from the given brain (loads it if needed)."""
    if isinstance(content, str):
        m = REMEMBER.match(content)
        if m:
            yield remember(m.group(2))
            return
    with _lock:
        start(brain)
    system = ("You are AXIOM, an on-device AI running fully offline on the user's phone. "
              "Be concise and precise.\n\nWhat you know about the user:\n" + memory())
    body = {"messages": [{"role": "system", "content": system},
                         {"role": "user", "content": content}], "stream": True}
    req = urllib.request.Request(URL + "/v1/chat/completions", json.dumps(body).encode(),
                                 {"Content-Type": "application/json"})
    with urllib.request.urlopen(req) as r:
        for line in r:
            line = line.decode().strip()
            if not line.startswith("data:") or line.endswith("[DONE]"):
                continue
            choices = json.loads(line[5:]).get("choices") or [{}]
            delta = choices[0].get("delta", {}).get("content") or ""
            if delta:
                yield delta

def chat(content, brain):
    out = []
    for d in stream(content, brain):
        out.append(d)
        print(d, end="", flush=True)
    print()
    return "".join(out)

def see(question):
    img = os.path.join(AX, "eye.jpg")
    subprocess.run(["termux-camera-photo", "-c", "0", img], check=True)
    b64 = base64.b64encode(open(img, "rb").read()).decode()
    return chat([{"type": "text", "text": question or "Describe what you see."},
                 {"type": "image_url", "image_url": {"url": f"data:image/jpeg;base64,{b64}"}}], "vision")

def voice():
    print("[axiom] voice mode: speak after the beep. Say 'goodbye' to exit.")
    while True:
        heard = subprocess.run(["termux-speech-to-text"], capture_output=True, text=True).stdout.strip()
        if not heard:
            continue
        print(f"> {heard}")
        if re.search(r"\b(goodbye|exit|stop)\b", heard, re.I):
            break
        reply = chat(heard, route(heard))
        reply = re.sub(r"<think>.*?</think>", "", reply, flags=re.S)
        subprocess.run(["termux-tts-speak", reply[:1500]])

_cache = {"t": 0, "bat": None}

def vitals():
    v = {"brain": current(), "up": healthy(), "brains": list(BRAINS)}
    try:
        mi = dict(l.split(":", 1) for l in open("/proc/meminfo"))
        tot, av = (int(mi[k].split()[0]) for k in ("MemTotal", "MemAvailable"))
        v["ram"] = round(100 * (tot - av) / tot)
    except Exception:
        pass
    if time.time() - _cache["t"] > 30:
        try:
            _cache["bat"] = json.loads(subprocess.run(["termux-battery-status"], capture_output=True,
                                                      text=True, timeout=5).stdout)
        except Exception:
            _cache["bat"] = None
        _cache["t"] = time.time()
    if _cache["bat"]:
        v["battery"] = _cache["bat"].get("percentage")
        v["temp"] = _cache["bat"].get("temperature")
    return v

class Hud(BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def _json(self, obj, code=200):
        b = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.end_headers()
        self.wfile.write(b)

    def do_GET(self):
        if self.path in ("/", "/index.html"):
            b = open(HUD_FILE, "rb").read()
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.end_headers()
            self.wfile.write(b)
        elif self.path == "/api/status":
            self._json(vitals())
        elif self.path == "/api/memory":
            self._json({"memory": memory()})
        else:
            self._json({"error": "not found"}, 404)

    def do_POST(self):
        req = json.loads(self.rfile.read(int(self.headers.get("Content-Length", 0))) or b"{}")
        if self.path == "/api/stop":
            stop()
            return self._json({"ok": True})
        if self.path != "/api/chat":
            return self._json({"error": "not found"}, 404)
        msg, img = req.get("message", ""), req.get("image")
        brain = req.get("brain") or "auto"
        if img:
            brain = "vision"
            content = [{"type": "text", "text": msg or "Describe what you see."},
                       {"type": "image_url", "image_url": {"url": img}}]
        else:
            brain = route(msg) if brain == "auto" else brain
            content = msg
        self.send_response(200)
        self.send_header("Content-Type", "application/x-ndjson")
        self.end_headers()
        send = lambda o: (self.wfile.write((json.dumps(o) + "\n").encode()), self.wfile.flush())
        try:
            send({"brain": brain, "loading": current() != brain})
            for d in stream(content, brain):
                send({"d": d})
        except SystemExit as e:
            send({"error": str(e)})
        except Exception as e:
            send({"error": f"{type(e).__name__}: {e}"})
        send({"done": True})

HUD_FILE = os.environ.get("AXIOM_HUD", os.path.join(AX, "hud.html"))
HUD_PORT = CONF.getint("server", "hud_port", fallback=7777)
_lock = threading.Lock()

def hud():
    srv = ThreadingHTTPServer(("127.0.0.1", HUD_PORT), Hud)
    print(f"[axiom] HUD online at http://127.0.0.1:{HUD_PORT}  (Ctrl+C to exit)")
    srv.serve_forever()

USAGE = """AXIOM: local AI switchboard
  axiom ask "question"        auto-route to the best brain
  axiom ask -b code "..."     force a brain (chat|think|code|vision)
  axiom see ["question"]      take a photo and ask the vision brain
  axiom voice                 hands-free talk loop (offline)
  axiom hud                   launch the HUD app at http://127.0.0.1:7777
  axiom remember "fact"       store a fact in the memory core
  axiom start <brain>         load a brain + web UI at http://127.0.0.1:8080
  axiom stop | status"""

def main(a):
    if not a or a[0] in ("-h", "--help", "help"):
        print(USAGE)
    elif a[0] == "start":
        start(a[1] if len(a) > 1 else "chat")
    elif a[0] == "stop":
        stop(); print("[axiom] offline")
    elif a[0] == "status":
        b = current()
        print(f"brain: {b or 'none'}  server: {'up' if healthy() else 'down'}  brains: {', '.join(BRAINS)}")
    elif a[0] == "ask":
        rest = a[1:]
        brain = None
        if rest[:1] == ["-b"]:
            brain, rest = rest[1], rest[2:]
        q = " ".join(rest) or sys.stdin.read()
        chat(q, brain or route(q))
    elif a[0] == "see":
        see(" ".join(a[1:]))
    elif a[0] == "voice":
        voice()
    elif a[0] == "hud":
        hud()
    elif a[0] == "remember":
        print(remember(" ".join(a[1:])))
    else:
        print(USAGE); sys.exit(1)

if __name__ == "__main__":
    main(sys.argv[1:])
